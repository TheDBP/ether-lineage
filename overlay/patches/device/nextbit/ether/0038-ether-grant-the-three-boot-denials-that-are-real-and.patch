From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Fri, 25 Sep 2026 14:18:11 -0400
Subject: [PATCH] ether: grant the three boot denials that are real, and
 explain the fourth

Captured from a running handset rather than written from memory, which changed the
answer for one of them.

robinled_app wanted search on system_data_file: it traverses /data to reach its own
sandbox. search on the directory grants no listing and no read of anything inside.

ueventd wanted read on /proc/device-tree/compatible while resolving a firmware
load. Unlabelled that is plain `proc`, and granting read on `proc` would hand it
everything unlabelled under /proc -- so it gets its own type and a genfscon, and
ueventd is allowed only that.

storaged wanted read on sysfs_disk_stat. The path was already labelled by
device/qcom/sepolicy-legacy and the type already declared in file.te; only the
permission was missing, so the read failed on every poll and storaged attributed no
disk I/O at all.

init's write to discard_max_bytes is deliberately NOT granted. The file is
-r--r--r-- on this 3.10 kernel and the writer is upstream AOSP's own
/system/etc/init/hw/init.rc, so the write fails on the file mode whatever the
policy says. An allow would silence the denial without changing behaviour, and
mislabelling the mmc request queue to do it is not worth three log lines a boot.
---
 sepolicy/file.te         | 4 ++++
 sepolicy/genfs_contexts  | 1 +
 sepolicy/robinled_app.te | 4 ++++
 sepolicy/storaged.te     | 5 +++++
 sepolicy/ueventd.te      | 5 +++++
 5 files changed, 19 insertions(+)
 create mode 100644 sepolicy/storaged.te
 create mode 100644 sepolicy/ueventd.te

diff --git a/sepolicy/file.te b/sepolicy/file.te
index 01349a0..3267831 100644
--- a/sepolicy/file.te
+++ b/sepolicy/file.te
@@ -11,3 +11,7 @@ type proc_kernel_sched, fs_type;
 type sysfs_disk_stat, fs_type, sysfs_type;
 # proc_dirty_ratio NOT declared here: the qcom policy already has it in common/file.te,
 # written as "type  proc_dirty_ratio" with two spaces -- which a "type <name>" regex misses.
+
+# /proc/device-tree, which ueventd reads while resolving a firmware load. Unlabelled it falls through
+# to `proc`, and granting a domain read on `proc` hands it everything unlabelled under /proc.
+type proc_device_tree, fs_type, proc_type;
diff --git a/sepolicy/genfs_contexts b/sepolicy/genfs_contexts
index 77beccb..845ded1 100644
--- a/sepolicy/genfs_contexts
+++ b/sepolicy/genfs_contexts
@@ -26,3 +26,4 @@ genfscon sysfs /devices/soc.0/fih_battery.84/power_supply/fih_battery   u:object
 genfscon sysfs /devices/soc.0/msm-bcl-15/power_supply/fg_adc            u:object_r:sysfs_battery_supply:s0
 genfscon sysfs /devices/soc.0/qcom,bcl.67/power_supply/bcl              u:object_r:sysfs_battery_supply:s0
 genfscon proc  /sys/vm/swappiness                       u:object_r:proc_swappiness:s0
+genfscon proc  /device-tree                             u:object_r:proc_device_tree:s0
diff --git a/sepolicy/robinled_app.te b/sepolicy/robinled_app.te
index d630603..90859aa 100644
--- a/sepolicy/robinled_app.te
+++ b/sepolicy/robinled_app.te
@@ -16,3 +16,7 @@ allow robinled_app app_api_service:service_manager find;
 allow robinled_app sysfs_leds:dir search;
 allow robinled_app sysfs_leds:lnk_file read;
 allow robinled_app sysfs_leds:file rw_file_perms;
+
+# Traverse /data to reach its own sandbox. `search` on the directory only -- it grants no listing and
+# no read of anything inside, which is why this is narrower than it looks.
+allow robinled_app system_data_file:dir search;
diff --git a/sepolicy/storaged.te b/sepolicy/storaged.te
new file mode 100644
index 0000000..317924b
--- /dev/null
+++ b/sepolicy/storaged.te
@@ -0,0 +1,5 @@
+# storaged reads the eMMC request statistics to attribute disk I/O per uid. The path is already
+# labelled sysfs_disk_stat by device/qcom/sepolicy-legacy (legacy-common/file_contexts), and the type
+# is declared in file.te here -- only the permission was missing, so the read was denied on every
+# poll and storaged reported nothing.
+allow storaged sysfs_disk_stat:file r_file_perms;
diff --git a/sepolicy/ueventd.te b/sepolicy/ueventd.te
new file mode 100644
index 0000000..979f367
--- /dev/null
+++ b/sepolicy/ueventd.te
@@ -0,0 +1,5 @@
+# ueventd reads /proc/device-tree/compatible while resolving a firmware load. Unlabelled that file is
+# plain `proc`, and allowing read on `proc` would grant everything unlabelled under /proc, so it is
+# given its own type in file.te and labelled in genfs_contexts.
+allow ueventd proc_device_tree:dir search;
+allow ueventd proc_device_tree:file r_file_perms;
