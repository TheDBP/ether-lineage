From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Wed, 23 Sep 2026 23:03:08 -0400
Subject: [PATCH] ether: make the flashlight work -- permissions, a label, and
 the strobe write

Three independent things were wrong, and fixing any one alone still left the torch dark.

Permissions. The camera provider runs as cameraserver in the camera group, and the kernel leaves the
torch nodes root:root 0644, so open() for write failed with EACCES. ueventd now chowns brightness AND
strobe on both torch LEDs to system:camera 0660.

Label. Upstream labels /class/leds as sysfs_leds, but that is the symlink directory -- opening
through it resolves to the real node under /devices/soc.0/qpnp-flash-led-27, which falls through to
generic sysfs. genfs_contexts labels the flash-LED device, and hal_camera_default gets rw on
sysfs_leds, which upstream grants only to hal_light.

The strobe write. qpnp-flash-led takes two writes: brightness programs the current, strobe gates the
output. QCameraFlash wrote only brightness, so once the permission and label problems were fixed the
tile stopped erroring and still produced no light -- every write succeeded and the torch reported on.
Confirmed against the driver's own reg_dump: brightness alone leaves REG_0xd342=0x00 and
REG_0xd347=0x40; adding strobe moves them to 0x05 and 0xc0.

Order matters on the way down -- strobe off before brightness off -- so the LED is gated before its
current is removed.

Two things worth remembering. The permission failure produces no avc denial, because DAC rejects the
open before SELinux is consulted; it surfaces as CameraService reporting "Camera 0 is in use" while
dumpsys media.camera says device 0 is closed with no client. And the camera app's flash never told us
anything useful: capture-time flash goes through the v4l2 subdev in the HAL, a completely different
path from the sysfs torch.
---
 camera/QCamera2/util/QCameraFlash.cpp | 39 +++++++++++++++++++++++++++
 rootdir/ueventd.qcom.rc               | 12 +++++++++
 sepolicy/genfs_contexts               |  6 +++++
 sepolicy/hal_camera_default.te        |  7 +++++
 4 files changed, 64 insertions(+)
 create mode 100644 sepolicy/hal_camera_default.te

diff --git a/camera/QCamera2/util/QCameraFlash.cpp b/camera/QCamera2/util/QCameraFlash.cpp
index ff30585..c4ea977 100644
--- a/camera/QCamera2/util/QCameraFlash.cpp
+++ b/camera/QCamera2/util/QCameraFlash.cpp
@@ -29,6 +29,8 @@
 
 #include <stdio.h>
 #include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
 #include <linux/media.h>
 #include <media/msmb_camera.h>
 #include <media/msm_cam_sensor.h>
@@ -42,6 +44,19 @@
 #define FLASH_PATH_FIRST "/sys/class/leds/led:torch_0/brightness"
 #define FLASH_PATH_SECOND "/sys/class/leds/led:torch_1/brightness"
 
+/*
+ * qpnp-flash-led needs two writes, not one: brightness sets the current, strobe gates the output.
+ * Writing brightness alone leaves the LED dark while every write succeeds and the torch reports as
+ * on -- which is exactly what the quick-settings tile did: no error, no light. Confirmed against the
+ * driver's own reg_dump, where brightness alone leaves REG_0xd342=0x00 and REG_0xd347=0x40 while
+ * adding strobe moves them to 0x05 and 0xc0.
+ *
+ * Opened per call rather than held like the brightness fds: the torch is toggled by hand, so the
+ * cost is irrelevant beside leaving initFlash and the fd pair untouched.
+ */
+#define STROBE_PATH_FIRST "/sys/class/leds/led:torch_0/strobe"
+#define STROBE_PATH_SECOND "/sys/class/leds/led:torch_1/strobe"
+
 volatile uint32_t gCamHal3LogLevel = 1;
 
 namespace qcamera {
@@ -217,6 +232,26 @@ int32_t QCameraFlash::initFlash(const int camera_id)
  *   -EINVAL  : No camera present at camera_id, or it is not inited.
  *   -EALREADY: Flash is already in requested state
  *==========================================================================*/
+/*===========================================================================
+ * FUNCTION   : setStrobe
+ *
+ * DESCRIPTION: Gate the torch LED output. Brightness on its own only programs
+ *              the current; without this the LED never lights.
+ *==========================================================================*/
+static void setStrobe(const char *path, bool on)
+{
+    int fd = open(path, O_WRONLY);
+    if (fd < 0) {
+        ALOGE("%s: unable to open %s", __func__, path);
+        return;
+    }
+    const char *val = on ? "1" : "0";
+    if (write(fd, val, strlen(val)) <= 0) {
+        ALOGE("%s: unable to write %s to %s", __func__, val, path);
+    }
+    close(fd);
+}
+
 int32_t QCameraFlash::setFlashMode(const int camera_id, const bool mode, flashLed led)
 {
     int32_t retVal = 0;
@@ -246,7 +281,9 @@ int32_t QCameraFlash::setFlashMode(const int camera_id, const bool mode, flashLe
             if (mode) {
                 int bytes = snprintf(buffer, sizeof(buffer), "70");
                 count = write(m_flashFds[camera_id].first, buffer, (size_t)bytes);
+                setStrobe(STROBE_PATH_FIRST, true);
             } else {
+                setStrobe(STROBE_PATH_FIRST, false);
                 int bytes = snprintf(buffer, sizeof(buffer), "0");
                 count = write(m_flashFds[camera_id].first, buffer, (size_t)bytes);
             }
@@ -267,7 +304,9 @@ int32_t QCameraFlash::setFlashMode(const int camera_id, const bool mode, flashLe
             if (mode) {
                 int bytes = snprintf(buffer, sizeof(buffer), "70");
                 count = write(m_flashFds[camera_id].second, buffer, (size_t)bytes);
+                setStrobe(STROBE_PATH_SECOND, true);
             } else {
+                setStrobe(STROBE_PATH_SECOND, false);
                 int bytes = snprintf(buffer, sizeof(buffer), "0");
                 count = write(m_flashFds[camera_id].second, buffer, (size_t)bytes);
             }
diff --git a/rootdir/ueventd.qcom.rc b/rootdir/ueventd.qcom.rc
index 8b30c9c..aa7ee25 100644
--- a/rootdir/ueventd.qcom.rc
+++ b/rootdir/ueventd.qcom.rc
@@ -228,3 +228,15 @@
 
 # Add device block for FRP
 /dev/block/platform/soc.0/f9824900.sdhci/by-name/config   0660   system     system
+
+# Camera torch (flashlight). The camera provider drives it by writing brightness on these two LEDs,
+# and it runs as cameraserver in the camera group -- so the kernel default of root:root 0644 makes
+# open() for write fail with EACCES before SELinux is ever consulted. The provider then logs
+#   initFlash: Unable to open node '/sys/class/leds/led:torch_0/brightness'
+# and every setTorchMode returns EBUSY, which reaches the user as "Camera 0 is in use" with no avc
+# denial to point at the real cause.
+/sys/devices/soc.0/qpnp-flash-led-27/leds/led:torch_0   brightness   0660   system   camera
+/sys/devices/soc.0/qpnp-flash-led-27/leds/led:torch_1   brightness   0660   system   camera
+# strobe too: brightness only programs the current, strobe gates the output, and the HAL needs both.
+/sys/devices/soc.0/qpnp-flash-led-27/leds/led:torch_0   strobe       0660   system   camera
+/sys/devices/soc.0/qpnp-flash-led-27/leds/led:torch_1   strobe       0660   system   camera
diff --git a/sepolicy/genfs_contexts b/sepolicy/genfs_contexts
index 77beccb..93e4e7c 100644
--- a/sepolicy/genfs_contexts
+++ b/sepolicy/genfs_contexts
@@ -26,3 +26,9 @@ genfscon sysfs /devices/soc.0/fih_battery.84/power_supply/fih_battery   u:object
 genfscon sysfs /devices/soc.0/msm-bcl-15/power_supply/fg_adc            u:object_r:sysfs_battery_supply:s0
 genfscon sysfs /devices/soc.0/qcom,bcl.67/power_supply/bcl              u:object_r:sysfs_battery_supply:s0
 genfscon proc  /sys/vm/swappiness                       u:object_r:proc_swappiness:s0
+
+# The flash/torch LEDs. Upstream labels /class/leds as sysfs_leds, but that is the symlink directory:
+# opening /sys/class/leds/led:torch_0/brightness resolves to the real node under /devices, which
+# falls through to generic sysfs and is not writable by the camera HAL. Label the flash-LED device
+# itself so the write lands on sysfs_leds.
+genfscon sysfs /devices/soc.0/qpnp-flash-led-27          u:object_r:sysfs_leds:s0
diff --git a/sepolicy/hal_camera_default.te b/sepolicy/hal_camera_default.te
new file mode 100644
index 0000000..f643b43
--- /dev/null
+++ b/sepolicy/hal_camera_default.te
@@ -0,0 +1,7 @@
+# The torch is a sysfs LED rather than something the camera HAL reaches through its own device
+# nodes, so it needs explicit access. sysfs_leds is an upstream type (system/sepolicy/public/file.te)
+# and this device's genfs_contexts puts the flash-LED device under it; only hal_light is granted
+# write upstream, which is why the camera provider could not use it.
+allow hal_camera_default sysfs_leds:dir r_dir_perms;
+allow hal_camera_default sysfs_leds:file rw_file_perms;
+allow hal_camera_default sysfs_leds:lnk_file read;
