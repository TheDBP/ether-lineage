From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Wed, 23 Sep 2026 11:11:34 -0400
Subject: [PATCH] ether: IMS daemons, sepolicy and JNI symlinks (VoLTE step 4)

The daemon set comes from ether's OWN stock ramdisk, not from bullhead. Bullhead starts two;
ether's stock init.target.rc runs a three-stage chain plus a fourth service:

  imsqmidaemon -> sys.ims.QMI_DAEMON_STATUS=1 -> imsdatadaemon
               -> sys.ims.DATA_DAEMON_STATUS=1 -> ims_rtp_daemon (socket ims_rtpd)
  imscmservice: class main, no socket, always running

imsqmidaemon and imsdatadaemon are byte-identical between the two devices, which is why porting the
rest from bullhead was safe; the two extra stages would have been missed entirely.

sepolicy/ims.te is bullhead's domain minus device_domain_deprecated, which does not exist on 13, so
anything it silently granted has to be re-derived from real denials. Paths are /vendor/bin.

Android.mk symlinks the JNI libraries into vendor/app/ims/lib/arm64 -- the APK looks for them there
rather than on the library path, and without them it installs and cannot place a call.

device.mk -includes the staged blob fragment, so a build without extract-ims-blobs.sh is simply a
build without IMS rather than a build that fails.
---
 Android.mk                 | 15 +++++++++++++++
 device.mk                  |  4 ++++
 rootdir/init.target.rc     | 38 ++++++++++++++++++++++++++++++++++++++
 sepolicy/file.te           |  3 +++
 sepolicy/file_contexts     |  9 +++++++++
 sepolicy/ims.te            | 32 ++++++++++++++++++++++++++++++++
 sepolicy/property.te       |  3 +++
 sepolicy/property_contexts |  3 +++
 sepolicy/rild.te           |  3 +++
 9 files changed, 110 insertions(+)
 create mode 100644 sepolicy/ims.te

diff --git a/Android.mk b/Android.mk
index b5e39d7..1983362 100644
--- a/Android.mk
+++ b/Android.mk
@@ -55,4 +55,19 @@ $(RFS_MSM_MPSS_SYMLINKS): $(LOCAL_INSTALLED_MODULE)
 
 ALL_DEFAULT_INSTALLED_MODULES += $(RFS_MSM_ADSP_SYMLINKS) $(RFS_MSM_MPSS_SYMLINKS)
 
+
+# IMS / VoLTE: org.codeaurora.ims looks for its JNI libraries inside its own APK directory rather
+# than on the normal library path, so they have to be symlinked into vendor/app/ims/lib/arm64.
+# Copied from device_lge_bullhead, which needed exactly this for the same APK. Missing these gives
+# an ims.apk that installs and then cannot place a call, with no obvious error.
+IMS_LIBS := libimscamera_jni.so libimsmedia_jni.so
+IMS_SYMLINKS := $(addprefix $(TARGET_OUT_VENDOR)/app/ims/lib/arm64/,$(notdir $(IMS_LIBS)))
+$(IMS_SYMLINKS): $(LOCAL_INSTALLED_MODULE)
+	@echo "IMS lib link: $@"
+	@mkdir -p $(dir $@)
+	@rm -rf $@
+	$(hide) ln -sf /vendor/lib64/$(notdir $@) $@
+
+ALL_DEFAULT_INSTALLED_MODULES += $(IMS_SYMLINKS)
+
 endif
diff --git a/device.mk b/device.mk
index 7d47f14..40c4092 100644
--- a/device.mk
+++ b/device.mk
@@ -335,6 +335,10 @@ endif
 # this makefile, so the test below ran against an empty value and every WITH_OEM build silently fell
 # through to the skin's. -include, so a build without the pack staged is still fine.
 -include vendor/extra/oem-assets/assets-vars.mk
+
+# IMS / VoLTE blobs, staged out of the stock zip by extract-ims-blobs.sh. -include, because the
+# file only exists when that script has run: a build without it is simply a build without IMS.
+-include vendor/extra/ims-blobs/ims-blobs.mk
 ifeq ($(WITH_OEM),true)
 ifneq ($(OEM_DEFAULT_WALLPAPER),)
 ether_def_wallpaper := $(OEM_DEFAULT_WALLPAPER)
diff --git a/rootdir/init.target.rc b/rootdir/init.target.rc
index fbad491..9d89aac 100644
--- a/rootdir/init.target.rc
+++ b/rootdir/init.target.rc
@@ -129,3 +129,41 @@ service energy-awareness /vendor/bin/energy-awareness
     user root
     group system
     oneshot
+
+# IMS / VoLTE. Ported from device_lge_bullhead (same msm8992, same QTI IMS generation), with the
+# paths moved from /system/bin to /vendor/bin where our blobs land. imsdatadaemon starts only once
+# imsqmidaemon has reached the modem and set sys.ims.QMI_DAEMON_STATUS, which is why it is disabled
+# here rather than class main.
+service imsqmidaemon /vendor/bin/imsqmidaemon
+    class main
+    user system
+    socket ims_qmid stream 0660 system radio
+    group radio net_raw log diag
+
+service imsdatadaemon /vendor/bin/imsdatadaemon
+    class main
+    user system
+    socket ims_datad stream 0660 system radio
+    group system wifi radio inet net_raw log diag net_admin
+    disabled
+
+on property:sys.ims.QMI_DAEMON_STATUS=1
+    start imsdatadaemon
+
+# ether's stock init runs a third stage bullhead never had: imsdatadaemon sets DATA_DAEMON_STATUS
+# and that starts the RTP daemon. Taken from the stock ramdisk's own init.target.rc, not ported.
+service ims_rtp_daemon /vendor/bin/ims_rtp_daemon
+    class main
+    user system
+    socket ims_rtpd stream 0660 system radio
+    group radio net_raw diag inet log
+    disabled
+
+on property:sys.ims.DATA_DAEMON_STATUS=1
+    start ims_rtp_daemon
+
+# No socket and no trigger on stock: it just runs.
+service imscmservice /vendor/bin/imscmservice
+    class main
+    user system
+    group radio net_raw diag inet log
diff --git a/sepolicy/file.te b/sepolicy/file.te
index 01349a0..c3da705 100644
--- a/sepolicy/file.te
+++ b/sepolicy/file.te
@@ -11,3 +11,6 @@ type proc_kernel_sched, fs_type;
 type sysfs_disk_stat, fs_type, sysfs_type;
 # proc_dirty_ratio NOT declared here: the qcom policy already has it in common/file.te,
 # written as "type  proc_dirty_ratio" with two spaces -- which a "type <name>" regex misses.
+
+# Socket nodes init creates for the IMS daemons
+type ims_socket, file_type;
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index 3a3e621..29ba4f5 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -37,3 +37,12 @@
 
 # Modem subsystem holder
 /(system/vendor|vendor)/bin/ether_modem_hold                             u:object_r:modem_hold_exec:s0
+
+# IMS / VoLTE
+/dev/socket/ims_qmid                                                    u:object_r:ims_socket:s0
+/dev/socket/ims_datad                                                   u:object_r:ims_socket:s0
+/dev/socket/ims_rtpd                                                    u:object_r:ims_socket:s0
+/(system/vendor|vendor)/bin/imsqmidaemon                                u:object_r:ims_exec:s0
+/(system/vendor|vendor)/bin/imsdatadaemon                               u:object_r:ims_exec:s0
+/(system/vendor|vendor)/bin/ims_rtp_daemon                              u:object_r:ims_exec:s0
+/(system/vendor|vendor)/bin/imscmservice                                u:object_r:ims_exec:s0
diff --git a/sepolicy/ims.te b/sepolicy/ims.te
new file mode 100644
index 0000000..5891733
--- /dev/null
+++ b/sepolicy/ims.te
@@ -0,0 +1,32 @@
+# IMS (IP Multimedia Subsystem) daemons: imsqmidaemon and imsdatadaemon.
+#
+# Ported from device_lge_bullhead lineage-16.0. Two deliberate differences:
+#   - device_domain_deprecated does not exist on 13, so it is gone; anything it used to grant has to
+#     be asked for explicitly here, driven by real denials rather than guessed.
+#   - the daemons live in /vendor/bin, not /system/bin.
+#
+# Everything below is the minimum bullhead needed. Expect to add to it: 13's neverallows are
+# stricter than 9's, and this has not yet been through a boot.
+type ims, domain;
+type ims_exec, exec_type, vendor_file_type, file_type;
+
+init_daemon_domain(ims)
+
+allow ims self:capability { net_raw net_admin };
+
+# ims talks to itself over a socket, and to the modem via QMI
+allow ims self:socket create_socket_perms;
+allowxperm ims self:socket ioctl msm_sock_ipc_ioctls;
+
+# tell init to start imsdatadaemon once the QMI side is up (sys.ims.QMI_DAEMON_STATUS)
+set_prop(ims, qcom_ims_prop)
+
+# write to the sockets init creates for it
+allow ims ims_socket:sock_file write;
+
+# the connectivity engine and netd
+unix_socket_connect(ims, cnd, cnd)
+unix_socket_connect(ims, netd, netd)
+
+# QMI transport
+qmux_socket(ims)
diff --git a/sepolicy/property.te b/sepolicy/property.te
index d3b31be..79ad3e4 100644
--- a/sepolicy/property.te
+++ b/sepolicy/property.te
@@ -1,2 +1,5 @@
 type audio_smartamp_init_prop, property_type;
 type vendor_timekeep_prop, property_type;
+
+# sys.ims.* — imsqmidaemon sets QMI_DAEMON_STATUS to start imsdatadaemon
+type qcom_ims_prop, property_type;
diff --git a/sepolicy/property_contexts b/sepolicy/property_contexts
index c9e974f..fa47f55 100644
--- a/sepolicy/property_contexts
+++ b/sepolicy/property_contexts
@@ -9,3 +9,6 @@ persist.vendor.timeadjust u:object_r:vendor_timekeep_prop:s0
 #           "bluetooth.core.le.vendor_capabilities.enabled"
 # so the gate silently defaulted to true and the APCF crash persisted.
 bluetooth.core.le.vendor_capabilities.enabled    u:object_r:bluetooth_config_prop:s0 exact bool
+
+# IMS daemon handshake
+sys.ims.                                         u:object_r:qcom_ims_prop:s0
diff --git a/sepolicy/rild.te b/sepolicy/rild.te
index e3987fe..21aee89 100644
--- a/sepolicy/rild.te
+++ b/sepolicy/rild.te
@@ -24,3 +24,6 @@ dontaudit rild vendor_file:file ioctl;
 # loads libril-qc-qmi-1.so:
 #   avc: denied { read } comm="rild" name="u:object_r:vendor_rild_libpath_prop:s0"
 get_prop(rild, vendor_rild_libpath_prop)
+
+# rild writes the IMS sockets that imsqmidaemon/imsdatadaemon create
+allow rild ims_socket:sock_file write;
