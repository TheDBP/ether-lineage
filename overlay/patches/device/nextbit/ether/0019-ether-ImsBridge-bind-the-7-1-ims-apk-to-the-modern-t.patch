+import android.os.Parcelable;
+
+/** The 7.1 com.android.ims.ImsStreamMediaProfile, renamed. Four ints, in 7.1's order. */
+public class ImsStreamMediaProfile implements Parcelable {
+    public int mAudioQuality;
+    public int mAudioDirection;
+    public int mVideoQuality;
+    public int mVideoDirection;
+
+    public ImsStreamMediaProfile() { }
+
+    private ImsStreamMediaProfile(Parcel in) { readFromParcel(in); }
+
+    @Override
+    public int describeContents() { return 0; }
+
+    @Override
+    public void writeToParcel(Parcel out, int flags) {
+        out.writeInt(mAudioQuality);
+        out.writeInt(mAudioDirection);
+        out.writeInt(mVideoQuality);
+        out.writeInt(mVideoDirection);
+    }
+
+    private void readFromParcel(Parcel in) {
+        mAudioQuality = in.readInt();
+        mAudioDirection = in.readInt();
+        mVideoQuality = in.readInt();
+        mVideoDirection = in.readInt();
+    }
+
+    public static final Creator<ImsStreamMediaProfile> CREATOR = new Creator<ImsStreamMediaProfile>() {
+        @Override
+        public ImsStreamMediaProfile createFromParcel(Parcel in) { return new ImsStreamMediaProfile(in); }
+        @Override
+        public ImsStreamMediaProfile[] newArray(int size) { return new ImsStreamMediaProfile[size]; }
+    };
+}
diff --git a/ims-bridge/src/org/lineageos/ims/bridge/Convert.java b/ims-bridge/src/org/lineageos/ims/bridge/Convert.java
new file mode 100644
index 0000000..8d3b08c
--- /dev/null
+++ b/ims-bridge/src/org/lineageos/ims/bridge/Convert.java
@@ -0,0 +1,61 @@
+package org.lineageos.ims.bridge;
+
+/**
+ * Parcelable conversion between the 7.1 types the ims.apk speaks and the modern ones the platform
+ * expects. Every one of these is a handful of fields: the originals look enormous only because
+ * ImsReasonInfo carries 88 constants alongside its 3 instance fields.
+ */
+public final class Convert {
+    private Convert() { }
+
+    public static android.telephony.ims.ImsReasonInfo toModern(
+            org.codeaurora.ims.legacy.ImsReasonInfo in) {
+        if (in == null) return null;
+        return new android.telephony.ims.ImsReasonInfo(in.mCode, in.mExtraCode, in.mExtraMessage);
+    }
+
+    public static org.codeaurora.ims.legacy.ImsReasonInfo toLegacy(
+            android.telephony.ims.ImsReasonInfo in) {
+        if (in == null) return null;
+        return new org.codeaurora.ims.legacy.ImsReasonInfo(
+                in.getCode(), in.getExtraCode(), in.getExtraMessage());
+    }
+
+    public static android.telephony.ims.ImsStreamMediaProfile toModern(
+            org.codeaurora.ims.legacy.ImsStreamMediaProfile in) {
+        if (in == null) return null;
+        return new android.telephony.ims.ImsStreamMediaProfile(
+                in.mAudioQuality, in.mAudioDirection, in.mVideoQuality, in.mVideoDirection,
+                android.telephony.ims.ImsStreamMediaProfile.RTT_MODE_DISABLED);
+    }
+
+    public static org.codeaurora.ims.legacy.ImsStreamMediaProfile toLegacy(
+            android.telephony.ims.ImsStreamMediaProfile in) {
+        if (in == null) return null;
+        org.codeaurora.ims.legacy.ImsStreamMediaProfile out =
+                new org.codeaurora.ims.legacy.ImsStreamMediaProfile();
+        out.mAudioQuality = in.getAudioQuality();
+        out.mAudioDirection = in.getAudioDirection();
+        out.mVideoQuality = in.getVideoQuality();
+        out.mVideoDirection = in.getVideoDirection();
+        return out;
+    }
+
+    public static android.telephony.ims.ImsCallProfile toModern(
+            org.codeaurora.ims.legacy.ImsCallProfile in) {
+        if (in == null) return null;
+        return new android.telephony.ims.ImsCallProfile(in.mServiceType, in.mCallType,
+                in.mCallExtras, toModern(in.mMediaProfile));
+    }
+
+    public static org.codeaurora.ims.legacy.ImsCallProfile toLegacy(
+            android.telephony.ims.ImsCallProfile in) {
+        if (in == null) return null;
+        org.codeaurora.ims.legacy.ImsCallProfile out =
+                new org.codeaurora.ims.legacy.ImsCallProfile(
+                        in.getServiceType(), in.getCallType());
+        out.mCallExtras = in.getCallExtras();
+        out.mMediaProfile = toLegacy(in.getMediaProfile());
+        return out;
+    }
+}
diff --git a/ims-bridge/src/org/lineageos/ims/bridge/ImsBridgeService.java b/ims-bridge/src/org/lineageos/ims/bridge/ImsBridgeService.java
new file mode 100644
index 0000000..cc61a6a
--- /dev/null
+++ b/ims-bridge/src/org/lineageos/ims/bridge/ImsBridgeService.java
@@ -0,0 +1,31 @@
+package org.lineageos.ims.bridge;
+
+import android.telephony.ims.compat.ImsService;
+import android.telephony.ims.compat.feature.MMTelFeature;
+import android.util.Log;
+
+/**
+ * Binds ims.apk -- a 2016 QTI IMS stack built against an API Android 9 deleted -- to the modern
+ * telephony framework, through the compat ImsService path that frameworks/opt/telephony still
+ * carries (ImsServiceControllerCompat / MmTelFeatureCompatAdapter).
+ *
+ * For ImsResolver to bind this at all the device must also:
+ *   - ship android.hardware.telephony.ims.prebuilt.xml, or PhoneGlobals never builds an
+ *     ImsResolver in the first place, and
+ *   - point config_ims_mmtel_package at this package.
+ */
+public class ImsBridgeService extends ImsService {
+    static final String TAG = "ImsBridge";
+
+    @Override
+    public MMTelFeature onCreateMMTelImsFeature(int slotId) {
+        Log.i(TAG, "onCreateMMTelImsFeature slot=" + slotId);
+        return new LegacyMMTelFeature(slotId);
+    }
+
+    @Override
+    public MMTelFeature onCreateEmergencyMMTelImsFeature(int slotId) {
+        Log.i(TAG, "onCreateEmergencyMMTelImsFeature slot=" + slotId);
+        return new LegacyMMTelFeature(slotId);
+    }
+}
diff --git a/ims-bridge/src/org/lineageos/ims/bridge/LegacyMMTelFeature.java b/ims-bridge/src/org/lineageos/ims/bridge/LegacyMMTelFeature.java
new file mode 100644
index 0000000..289b1c7
--- /dev/null
+++ b/ims-bridge/src/org/lineageos/ims/bridge/LegacyMMTelFeature.java
@@ -0,0 +1,242 @@
+package org.lineageos.ims.bridge;
+
+import android.app.PendingIntent;
+import android.os.IBinder;
+import android.os.Message;
+import android.os.RemoteException;
+import android.os.ServiceManager;
+import android.telephony.ims.ImsCallProfile;
+import android.telephony.ims.compat.feature.ImsFeature;
+import android.telephony.ims.compat.feature.MMTelFeature;
+import android.telephony.ims.stub.ImsEcbmImplBase;
+import android.telephony.ims.stub.ImsMultiEndpointImplBase;
+import android.telephony.ims.stub.ImsUtImplBase;
+import android.util.Log;
+
+import com.android.ims.internal.IImsCallSession;
+import com.android.ims.internal.IImsCallSessionListener;
+import com.android.ims.internal.IImsConfig;
+import com.android.ims.internal.IImsRegistrationListener;
+
+import org.codeaurora.ims.legacy.internal.IImsService;
+
+/**
+ * Presents ims.apk's 7.1 IImsService to the platform as a modern MMTelFeature.
+ *
+ * The shape difference this class exists to absorb: the 7.1 API is serviceId-keyed -- open() hands
+ * back an int every later call must carry -- while a MMTelFeature instance already implies one
+ * session. So the bridge holds the id and injects it.
+ *
+ * ims.apk registers itself as "ims" with ServiceManager; it is not a bound service.
+ *
+ * Note that no MMTelFeature method declares RemoteException, while every legacy call throws it. The
+ * conversion is deliberate and happens in one place, callLegacy-style, rather than being swallowed
+ * per call site: a dead IMS service should surface, not read as "feature present but idle".
+ */
+public class LegacyMMTelFeature extends MMTelFeature {
+    private static final String TAG = ImsBridgeService.TAG;
+
+    /** 7.1 ImsServiceClass.MMTEL. */
+    private static final int SERVICE_CLASS_MMTEL = 1;
+
+    private static final int INVALID_SERVICE_ID = -1;
+
+    private final int mSlotId;
+    private int mServiceId = INVALID_SERVICE_ID;
+
+    LegacyMMTelFeature(int slotId) {
+        mSlotId = slotId;
+        setFeatureState(ImsFeature.STATE_INITIALIZING);
+        awaitLegacyService();
+    }
+
+    /**
+     * Publish STATE_READY once ims.apk has registered itself.
+     *
+     * This is the whole handshake and it is easy to get backwards: the framework will not call
+     * startSession on a feature that has not reported READY, so a feature that only becomes READY
+     * inside startSession never gets used at all -- ImsResolver binds it, onCreateMMTelImsFeature
+     * runs, and then nothing happens, with no error logged anywhere.
+     *
+     * ims.apk registers "ims" with ServiceManager from its own onCreate in com.android.phone, while
+     * the bridge is a separate process, so the two race. Wait for the service on a background thread
+     * rather than blocking the binder thread that created the feature.
+     */
+    private void awaitLegacyService() {
+        new Thread(() -> {
+            IBinder b = ServiceManager.waitForService("ims");
+            if (b == null) {
+                Log.e(TAG, "slot " + mSlotId + ": ims service never appeared; feature stays down");
+                setFeatureState(ImsFeature.STATE_NOT_AVAILABLE);
+                return;
+            }
+            Log.i(TAG, "slot " + mSlotId + ": legacy ims service present, feature READY");
+            setFeatureState(ImsFeature.STATE_READY);
+        }, "ImsBridge-await").start();
+    }
+
+    private IImsService legacyOrNull() {
+        IBinder b = ServiceManager.getService("ims");
+        if (b == null) {
+            Log.w(TAG, "slot " + mSlotId + ": ims service not registered");
+            return null;
+        }
+        return IImsService.Stub.asInterface(b);
+    }
+
+    private IImsService legacy() {
+        IImsService s = legacyOrNull();
+        if (s == null) {
+            throw new IllegalStateException("legacy ims service unavailable");
+        }
+        return s;
+    }
+
+    private static RuntimeException rethrow(String what, RemoteException e) {
+        Log.e(TAG, what + " failed across the bridge", e);
+        return new RuntimeException(what + ": " + e.getMessage(), e);
+    }
+
+    @Override
+    public int startSession(PendingIntent incomingCallIntent, IImsRegistrationListener listener) {
+        try {
+            RegistrationListenerAdapter adapter =
+                    listener != null ? new RegistrationListenerAdapter(listener) : null;
+            mServiceId = legacy().open(mSlotId, SERVICE_CLASS_MMTEL, incomingCallIntent, adapter);
+            Log.i(TAG, "slot " + mSlotId + ": legacy session open, serviceId=" + mServiceId);
+            // State is published by awaitLegacyService(); the framework only reaches this method
+            // because the feature already reported READY.
+            return mServiceId;
+        } catch (RemoteException e) {
+            throw rethrow("startSession", e);
+        }
+    }
+
+    @Override
+    public void endSession(int sessionId) {
+        try {
+            IImsService s = legacyOrNull();
+            if (s != null) {
+                s.close(sessionId);
+            }
+        } catch (RemoteException e) {
+            Log.e(TAG, "endSession failed", e);
+        } finally {
+            mServiceId = INVALID_SERVICE_ID;
+            setFeatureState(ImsFeature.STATE_NOT_AVAILABLE);
+        }
+    }
+
+    @Override
+    public boolean isConnected(int callSessionType, int callType) {
+        if (mServiceId == INVALID_SERVICE_ID) return false;
+        try {
+            return legacy().isConnected(mServiceId, callSessionType, callType);
+        } catch (RemoteException e) {
+            throw rethrow("isConnected", e);
+        }
+    }
+
+    @Override
+    public boolean isOpened() {
+        if (mServiceId == INVALID_SERVICE_ID) return false;
+        try {
+            return legacy().isOpened(mServiceId);
+        } catch (RemoteException e) {
+            throw rethrow("isOpened", e);
+        }
+    }
+
+    @Override
+    public void addRegistrationListener(IImsRegistrationListener listener) {
+        if (listener == null) return;
+        try {
+            legacy().addRegistrationListener(
+                    mServiceId, SERVICE_CLASS_MMTEL, new RegistrationListenerAdapter(listener));
+        } catch (RemoteException e) {
+            throw rethrow("addRegistrationListener", e);
+        }
+    }
+
+    @Override
+    public void removeRegistrationListener(IImsRegistrationListener listener) {
+        // 7.1 offers only setRegistrationListener, which REPLACES the single listener rather than
+        // detaching one of several. Calling it here would silently unhook whoever else registered,
+        // so do nothing and say so.
+        Log.d(TAG, "removeRegistrationListener ignored: 7.1 IImsService cannot detach a listener");
+    }
+
+    @Override
+    public ImsCallProfile createCallProfile(int sessionId, int callSessionType, int callType) {
+        try {
+            return Convert.toModern(
+                    legacy().createCallProfile(sessionId, callSessionType, callType));
+        } catch (RemoteException e) {
+            throw rethrow("createCallProfile", e);
+        }
+    }
+
+    @Override
+    public void turnOnIms() {
+        try {
+            legacy().turnOnIms(mSlotId);
+        } catch (RemoteException e) {
+            throw rethrow("turnOnIms", e);
+        }
+    }
+
+    @Override
+    public void turnOffIms() {
+        try {
+            legacy().turnOffIms(mSlotId);
+        } catch (RemoteException e) {
+            throw rethrow("turnOffIms", e);
+        }
+    }
+
+    @Override
+    public void setUiTTYMode(int uiTtyMode, Message onComplete) {
+        try {
+            legacy().setUiTTYMode(mServiceId, uiTtyMode, onComplete);
+        } catch (RemoteException e) {
+            throw rethrow("setUiTTYMode", e);
+        }
+    }
+
+    // --- Not yet bridged -------------------------------------------------------------------
+    // Each returns or consumes a 7.1 sub-interface where the modern side wants the 13 interface of
+    // the same name with a different method set, so each needs a wrapper -- and the corresponding
+    // legacy .aidl filled in with its real method order first (see the note in those files).
+    // Throwing is deliberate: returning null defers the failure to somewhere unrelated.
+
+    @Override
+    public IImsCallSession createCallSession(int sessionId, ImsCallProfile profile,
+            IImsCallSessionListener listener) {
+        throw new UnsupportedOperationException("createCallSession not bridged yet");
+    }
+
+    @Override
+    public IImsCallSession getPendingCallSession(int sessionId, String callId) {
+        throw new UnsupportedOperationException("getPendingCallSession not bridged yet");
+    }
+
+    @Override
+    public ImsUtImplBase getUtInterface() {
+        throw new UnsupportedOperationException("getUtInterface not bridged yet");
+    }
+
+    @Override
+    public IImsConfig getConfigInterface() {
+        throw new UnsupportedOperationException("getConfigInterface not bridged yet");
+    }
+
+    @Override
+    public ImsEcbmImplBase getEcbmInterface() {
+        throw new UnsupportedOperationException("getEcbmInterface not bridged yet");
+    }
+
+    @Override
+    public ImsMultiEndpointImplBase getMultiEndpointInterface() {
+        throw new UnsupportedOperationException("getMultiEndpointInterface not bridged yet");
+    }
+}
diff --git a/ims-bridge/src/org/lineageos/ims/bridge/RegistrationListenerAdapter.java b/ims-bridge/src/org/lineageos/ims/bridge/RegistrationListenerAdapter.java
new file mode 100644
index 0000000..ce40146
--- /dev/null
+++ b/ims-bridge/src/org/lineageos/ims/bridge/RegistrationListenerAdapter.java
@@ -0,0 +1,84 @@
+package org.lineageos.ims.bridge;
+
+import android.net.Uri;
+import android.os.RemoteException;
+
+import org.codeaurora.ims.legacy.ImsReasonInfo;
+import org.codeaurora.ims.legacy.internal.IImsRegistrationListener;
+
+/**
+ * Presents the platform's modern registration listener to ims.apk as a 7.1 one.
+ *
+ * All eleven 7.1 callbacks exist unchanged on 13 and forward directly. (13 gained
+ * registrationChangeFailed, which 7.1 never calls.)
+ *
+ * registrationFeatureCapabilityChanged is the important one and is easy to dismiss: it carries the
+ * enabled-feature bitmap, and MmTelFeatureCompatAdapter turns exactly this callback into
+ * MmTelCapabilities via notifyCapabilitiesStatusChanged. Drop it and the framework sees
+ * "Voice: false", decides IMS cannot carry a call, and routes to circuit-switched -- which on a
+ * carrier with no 2G/3G means the call simply fails.
+ */
+class RegistrationListenerAdapter extends IImsRegistrationListener.Stub {
+    private final com.android.ims.internal.IImsRegistrationListener mTarget;
+
+    RegistrationListenerAdapter(com.android.ims.internal.IImsRegistrationListener target) {
+        mTarget = target;
+    }
+
+    @Override
+    public void registrationConnected() throws RemoteException {
+        mTarget.registrationConnected();
+    }
+
+    @Override
+    public void registrationProgressing() throws RemoteException {
+        mTarget.registrationProgressing();
+    }
+
+    @Override
+    public void registrationConnectedWithRadioTech(int imsRadioTech) throws RemoteException {
+        mTarget.registrationConnectedWithRadioTech(imsRadioTech);
+    }
+
+    @Override
+    public void registrationProgressingWithRadioTech(int imsRadioTech) throws RemoteException {
+        mTarget.registrationProgressingWithRadioTech(imsRadioTech);
+    }
+
+    @Override
+    public void registrationDisconnected(ImsReasonInfo info) throws RemoteException {
+        mTarget.registrationDisconnected(Convert.toModern(info));
+    }
+
+    @Override
+    public void registrationResumed() throws RemoteException {
+        mTarget.registrationResumed();
+    }
+
+    @Override
+    public void registrationSuspended() throws RemoteException {
+        mTarget.registrationSuspended();
+    }
+
+    @Override
+    public void registrationServiceCapabilityChanged(int serviceClass, int event)
+            throws RemoteException {
+        mTarget.registrationServiceCapabilityChanged(serviceClass, event);
+    }
+
+    @Override
+    public void registrationFeatureCapabilityChanged(int serviceClass,
+            int[] enabledFeatures, int[] disabledFeatures) throws RemoteException {
+        mTarget.registrationFeatureCapabilityChanged(serviceClass, enabledFeatures, disabledFeatures);
+    }
+
+    @Override
+    public void voiceMessageCountUpdate(int count) throws RemoteException {
+        mTarget.voiceMessageCountUpdate(count);
+    }
+
+    @Override
+    public void registrationAssociatedUriChanged(Uri[] uris) throws RemoteException {
+        mTarget.registrationAssociatedUriChanged(uris);
+    }
+}
