--- /dev/null
+++ b/ims-bridge/aidl/org/codeaurora/ims/legacy/internal/IImsService.aidl
@@ -0,0 +1,45 @@
+package org.codeaurora.ims.legacy.internal;
+
+import android.app.PendingIntent;
+import android.os.Message;
+import org.codeaurora.ims.legacy.ImsCallProfile;
+import org.codeaurora.ims.legacy.internal.IImsCallSession;
+import org.codeaurora.ims.legacy.internal.IImsCallSessionListener;
+import org.codeaurora.ims.legacy.internal.IImsConfig;
+import org.codeaurora.ims.legacy.internal.IImsEcbm;
+import org.codeaurora.ims.legacy.internal.IImsMultiEndpoint;
+import org.codeaurora.ims.legacy.internal.IImsRegistrationListener;
+import org.codeaurora.ims.legacy.internal.IImsUt;
+
+/**
+ * The 7.1 com.android.ims.internal.IImsService, renamed to match the rebuilt ims.apk.
+ *
+ * METHOD ORDER IS LOAD-BEARING. AIDL assigns transaction codes by declaration order, and the other
+ * end of this interface is stock's compiled 7.1 binary inside ims.apk -- it cannot be recompiled to
+ * agree with us. The order below is transcribed from that binary's TRANSACTION_* constants
+ * (1 open ... 16 getMultiEndpointInterface). Do not reorder, insert, or remove.
+ *
+ * The API is serviceId-keyed: open() returns an id every later call must carry. The modern compat
+ * API has no such id -- a feature instance implies the session -- so the bridge holds it.
+ */
+interface IImsService {
+    int open(int phoneId, int serviceClass, in PendingIntent incomingCallIntent,
+            in IImsRegistrationListener listener);
+    void close(int serviceId);
+    boolean isConnected(int serviceId, int serviceType, int callType);
+    boolean isOpened(int serviceId);
+    void setRegistrationListener(int serviceId, in IImsRegistrationListener listener);
+    void addRegistrationListener(int serviceId, int serviceClass,
+            in IImsRegistrationListener listener);
+    ImsCallProfile createCallProfile(int serviceId, int serviceType, int callType);
+    IImsCallSession createCallSession(int serviceId, in ImsCallProfile profile,
+            in IImsCallSessionListener listener);
+    IImsCallSession getPendingCallSession(int serviceId, String callId);
+    IImsUt getUtInterface(int serviceId);
+    IImsConfig getConfigInterface(int phoneId);
+    void turnOnIms(int phoneId);
+    void turnOffIms(int phoneId);
+    IImsEcbm getEcbmInterface(int serviceId);
+    void setUiTTYMode(int serviceId, int uiTtyMode, in Message onComplete);
+    IImsMultiEndpoint getMultiEndpointInterface(int serviceId);
+}
