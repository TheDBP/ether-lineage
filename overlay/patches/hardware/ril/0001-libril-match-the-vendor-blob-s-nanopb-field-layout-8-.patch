From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TheDBP <TheDBP@users.noreply.github.com>
Date: Thu, 24 Sep 2026 04:34:15 -0400
Subject: [PATCH] libril: match the vendor blob's nanopb field layout (8-bit
 default)

nanopb fixes sizeof(pb_field_t) at compile time via PB_FIELD_8/16/32BIT, and libril is where that
choice lands for the whole RIL: QTI's libril-qc-qmi-1.so imports pb_encode/pb_decode from here rather
than carrying its own copy, and hands it descriptor arrays built against whatever width it was
compiled with.

Walking the widths against the msm8992 blob:

  32-bit (AOSP default for libril)  rild SIGSEGVs in encode_field -- the stride is so wide it runs
                                    off the end of the descriptor array
  16-bit                            no crash, but every field is misread:
                                      qcril_qmi_decode_npb: Decoding failed: missing required field
                                      qcril_qmi_encode_npb: Encoding failed: invalid data_size
  8-bit (nanopb default)            this change

pb_field_t is smallest at the default, so a stride that is still too wide explains misparsing without
crashing, which is exactly what 16-bit produced.

---
 libril/Android.mk | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/libril/Android.mk b/libril/Android.mk
index c39c5a9..b802e1c 100644
--- a/libril/Android.mk
+++ b/libril/Android.mk
@@ -24,11 +24,15 @@ LOCAL_SHARED_LIBRARIES := \
     android.hardware.radio@1.1 \
     libhidlbase \
 
+# nanopb's pb_field_t layout is decided at COMPILE time by PB_FIELD_8/16/32BIT, and libril is where
+# it lands: QTI's libril-qc-qmi-1.so imports pb_encode/pb_decode from here rather than carrying its
+# own. A 2016 blob built against one layout, handed descriptors to an encoder built with another,
+# walks off the end of the field array -- rild SIGSEGVs in encode_field the first time an IMS socket
+# client exists to send to. Match the blob, not the AOSP default.
 LOCAL_STATIC_LIBRARIES := \
-    libprotobuf-c-nano-enable_malloc-32bit \
+    libprotobuf-c-nano-enable_malloc \
 
 LOCAL_CFLAGS += -Wall -Wextra -Wno-unused-parameter -Werror
-LOCAL_CFLAGS += -DPB_FIELD_32BIT
 
 ifeq ($(SIM_COUNT), 2)
     LOCAL_CFLAGS += -DANDROID_MULTI_SIM -DDSDA_RILD1
